# Cpolar Deployment — Environment Variables Reference
# ============================================================
#
# Copy and paste these into your Cpolar deployment's Environment Variables section.
# Replace placeholder values (e.g., "your-brevo-api-key") with actual values.
#
# For more details, see CPOLAR_DEPLOY.md

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:10000
DOTNET_NOLOGO=true
DOTNET_PRINT_TELEMETRY_MESSAGE=false

# ============================================================
# Database Connection
# ============================================================
# For SQLite (testing only):
# ConnectionStrings__DefaultConnection=Data Source=/data/attendance.db

# For PostgreSQL (recommended for production):
# Replace: your-username, your-password, your-host, your-port, your-database
# NOTE: The app auto-detects "postgres://" prefix and switches to Npgsql
ConnectionStrings__DefaultConnection=postgres://your-username:your-password@your-host:5432/your-database

# ============================================================
# Application Security
# ============================================================
AttendanceMonitoring__RequireSecureCookie=true
AttendanceMonitoring__OnlineThresholdSeconds=600
AttendanceMonitoring__SessionLifetimeHours=12

# ============================================================
# Email Configuration (Brevo)
# ============================================================
# 1. Sign up at: https://www.brevo.com (free tier: 300 emails/day)
# 2. Get your API key from: https://app.brevo.com/settings/keys/api
# 3. Use the long "xkeysib-..." key (NOT the SMTP password)

Email__Provider=Brevo
Email__Enabled=true
Email__FromAddress=your-email@example.com
Email__FromName=Attendance Monitor

# Get this from https://app.brevo.com/settings/keys/api (the API key, not SMTP password)
Email__Username=xkeysib-your-actual-api-key-here
Email__Password=xkeysib-your-actual-api-key-here

# ============================================================
# Optional: Disable Telemetry (recommended for production)
# ============================================================
DOTNET_CLI_TELEMETRY_OPTOUT=1
