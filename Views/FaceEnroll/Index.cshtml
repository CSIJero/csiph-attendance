@model AttendanceMonitoring.ViewModels.FaceEnrollVm
@{
    ViewData["Title"] = "Face profile";
}

<section class="hero">
    <div>
        <h1>Face profile</h1>
        <p class="muted">
            Enroll a single reference selfie. Every subsequent check-in
            selfie is compared against this reference using a perceptual
            hash (a "fingerprint" of the image). If no profile exists, your
            latest stored check-in selfie is used automatically; otherwise
            manual enrollment is required.
        </p>
        <p class="muted">
            The account stores a one-way image hash and a 128-value face
            embedding used for matching. These values cannot be converted
            back into the original selfie.
        </p>
    </div>
</section>

<section class="card">
    @if (Model.IsEnrolled)
    {
        <p>
            <span class="pill pill-ok">Enrolled</span>
            <small class="muted">since @Model.EnrolledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
        </p>
    }
    else
    {
        <p>
            <span class="pill pill-off">Not enrolled</span>
            <small class="muted">Pick a past selfie below or capture a new photo.</small>
        </p>
    }
</section>

@if (Model.RecentSelfies.Count > 0)
{
    <section class="card">
        <div class="card-header">
            <h2>Enroll from a past check-in</h2>
            <small class="muted">@Model.RecentSelfies.Count most recent</small>
        </div>
        <p class="muted">
            Pick the photo that looks closest to how you usually appear
            at the camera. The selected image becomes the reference for
            all future check-in comparisons.
        </p>
        <div class="face-grid"
             style="display:grid; grid-template-columns:repeat(auto-fill, minmax(140px, 1fr)); gap:12px; margin-top:8px;">
            @foreach (var item in Model.RecentSelfies)
            {
                <form method="post" asp-action="EnrollFromHistory" class="face-tile"
                      data-face-history-form
                      style="display:flex; flex-direction:column; align-items:stretch; gap:6px;
                             border:1px solid var(--border,#ccc); border-radius:8px; padding:8px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="attendanceId" value="@item.AttendanceId" />
                    <input type="hidden" name="descriptor" value="" />
                    <img src="@item.Photo" alt="Check-in selfie @item.WorkDate"
                         style="width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:6px;" />
                    <div style="display:flex; flex-direction:column; gap:2px;">
                        <strong style="font-size:0.85rem;">@item.WorkDate.ToString("yyyy-MM-dd")</strong>
                        <small class="muted">@item.CheckIn.ToLocalTime().ToString("HH:mm")</small>
                        @if (!string.IsNullOrEmpty(item.FaceMatchStatus))
                        {
                            var pillClass = item.FaceMatchStatus switch
                            {
                                "Match" => "pill-ok",
                                "AutoEnrolled" => "pill-ok",
                                "Mismatch" => "pill-warn",
                                _ => "pill-info",
                            };
                            <span class="pill @pillClass" style="font-size:0.7rem;">@item.FaceMatchStatus</span>
                        }
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">
                        Use this photo
                    </button>
                </form>
            }
        </div>
    </section>
}
else
{
    <section class="card">
        <p class="muted">
            No past check-in selfies are available. Capture a fresh reference
            photo below before checking in.
        </p>
    </section>
}

<section class="card">
    <h2>Or capture a new reference photo</h2>
    <video id="face-video" autoplay playsinline muted style="width:100%; max-width:360px; background:#000; border-radius:8px;"></video>
    <canvas id="face-canvas" width="320" height="240" style="display:none;"></canvas>
    <div id="face-preview" style="margin-top:1em;"></div>

    <form method="post" asp-action="Enroll" id="face-form" class="form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="photo" id="face-photo" />
        <input type="hidden" name="descriptor" id="face-descriptor" />
        <div class="form-actions">
            <button type="button" class="btn" id="face-capture">Capture photo</button>
            <button type="submit" class="btn btn-primary" id="face-submit" disabled>Save as reference</button>
            @if (Model.IsEnrolled)
            {
                <button type="submit" class="btn btn-danger" formaction="@Url.Action("Clear")">Clear enrollment</button>
            }
        </div>
    </form>
</section>
