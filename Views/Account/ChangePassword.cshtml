@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    var errs = (ViewBag.FieldErrors as IDictionary<string, string>)
               ?? new Dictionary<string, string>();
}
<section class="hero">
    <div>
        <h1>Change password</h1>
        <p class="muted">
            Enter your current password, then choose a new one.
            <br />
            Use at least <strong>6 characters</strong> with one letter and one digit.
        </p>
    </div>
</section>

<section class="card">
    <div class="card-header"><h2>New password</h2></div>
    <form method="post"
          asp-controller="Account"
          asp-action="ChangePassword"
          class="stacked-form">
        @Html.AntiForgeryToken()

        <label>
            <span>Current password</span>
            <input type="password" name="CurrentPassword" required autofocus
                   autocomplete="current-password" />
            @if (errs.TryGetValue("CurrentPassword", out var curErr))
            {
                <small class="auth-field-error">@curErr</small>
            }
        </label>

        <label>
            <span>New password <small class="muted">&mdash; 6+ characters, one letter, one digit</small></span>
            <input type="password" name="NewPassword" required
                   autocomplete="new-password" minlength="6" />
            @if (errs.TryGetValue("NewPassword", out var newErr))
            {
                <small class="auth-field-error">@newErr</small>
            }
        </label>

        <label>
            <span>Confirm new password</span>
            <input type="password" name="ConfirmPassword" required
                   autocomplete="new-password" minlength="6" />
            @if (errs.TryGetValue("ConfirmPassword", out var confirmErr))
            {
                <small class="auth-field-error">@confirmErr</small>
            }
        </label>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update password</button>
            <a class="btn" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>
