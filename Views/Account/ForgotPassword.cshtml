@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card-v2">
    <div class="auth-card-head">
        <h1>Forgot Password</h1>
    </div>
    <div class="auth-card-body">
        <p class="auth-body-intro">
            For security, password resets are handled by your administrator.
        </p>
        <ol class="auth-steps">
            <li>Message your administrator and tell them you need a password reset.</li>
            <li>They'll generate a one-time temporary password for you.</li>
            <li>Sign in with that temporary password &mdash; the app will
                immediately ask you to choose a new password of your own.</li>
        </ol>
        <div class="auth-actions">
            <a asp-controller="Account" asp-action="Login" class="btn-auth"
               style="text-decoration:none;">Back</a>
            <a asp-controller="Account" asp-action="Register">Register here</a>
        </div>
    </div>
</div>

