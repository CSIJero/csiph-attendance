@model List<AttendanceMonitoring.Models.Holiday>
@{
    ViewData["Title"] = "Holidays";
    var filter = ViewBag.Filter as string;
}

<section class="hero">
    <div>
        <h1>Holidays</h1>
        <p class="muted">
            Statutory holidays drive two behaviours: the late-arrival
            rule is suppressed on a holiday (so on-call coverage isn't
            flagged), and the dashboard surfaces a banner so employees
            know that a check-in is voluntary.
        </p>
    </div>
    <div>
        <a class="btn btn-primary" asp-action="Create">+ Add holiday</a>
    </div>
</section>

<section class="card">
    <div class="card-header">
        <h2>Calendar</h2>
        <form method="get" class="form form-inline">
            <label>
                <span class="field-label">Country</span>
                <select name="country" onchange="this.form.submit()">
                    <option value="">All</option>
                    <option value="PH" selected="@(filter == "PH")">PH — Philippines</option>
                    <option value="IN" selected="@(filter == "IN")">IN — India</option>
                    <option value="ALL" selected="@(filter == "ALL")">ALL — Both</option>
                </select>
            </label>
        </form>
    </div>
    <div class="table-wrap">
        <table class="data-table sortable">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Country</th>
                    <th>Name</th>
                    <th>Kind</th>
                    <th style="width:160px;" data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="muted text-center">No holidays configured.</td></tr>
                }
                else
                {
                    foreach (var h in Model)
                    {
                        <tr>
                            <td>@h.Date.ToString("MMMM-dd-yyyy")</td>
                            <td><strong>@h.Country</strong></td>
                            <td>@h.Name</td>
                            <td>
                                <span class="pill pill-@(h.Kind == "Regular" ? "ok" : "info")">@h.Kind</span>
                            </td>
                            <td class="row-actions">
                                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@h.Id">Edit</a>
                                <form method="post" asp-action="Delete" asp-route-id="@h.Id"
                                      onsubmit="return confirm('Remove this holiday?');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
