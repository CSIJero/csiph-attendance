@model AttendanceMonitoring.Models.Holiday
@{
    ViewData["Title"] = "Edit holiday";
}

<section class="hero">
    <div>
        <h1>Edit holiday</h1>
    </div>
    <div>
        <a asp-action="Index" class="btn">&larr; Back</a>
    </div>
</section>

<section class="card">
    <form method="post" asp-action="EditPost" asp-route-id="@Model.Id" class="form">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label>
                <span class="field-label">Date <span class="req">*</span></span>
                <input type="date" asp-for="Date" required />
            </label>
            <label>
                <span class="field-label">Country <span class="req">*</span></span>
                <select asp-for="Country" required>
                    <option value="PH">PH — Philippines</option>
                    <option value="IN">IN — India</option>
                    <option value="ALL">ALL — Both regions</option>
                </select>
            </label>
            <label>
                <span class="field-label">Kind <span class="req">*</span></span>
                <select asp-for="Kind" required>
                    <option value="Regular">Regular</option>
                    <option value="Special">Special (non-working)</option>
                </select>
            </label>
        </div>
        <label>
            <span class="field-label">Name <span class="req">*</span></span>
            <input type="text" asp-for="Name" maxlength="120" required />
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn">Cancel</a>
        </div>
    </form>
</section>
