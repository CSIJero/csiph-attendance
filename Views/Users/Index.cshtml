@model UsersListViewModel
@{
    ViewData["Title"] = "Users";
    var isPureAdmin = User.IsInRole("admin");
    var isPm = User.IsInRole("pm");
    var meBu = ViewContext.HttpContext?.User?.FindFirst("BusinessUnit")?.Value;
    var meId = ViewContext.HttpContext?.User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var viewer = ViewData["ViewerUser"] as User;
}

<section class="hero">
    <div>
        <h1>Users</h1>
        <p class="muted">
            @if (isPureAdmin)
            {
                <text>Manage profile details for everyone on the team. Click <strong>Edit</strong> on
                a row to update name, email, role, business unit and more. Passwords can't
                be changed from here.</text>
            }
            else if (isPm)
            {
                <text>You can view and edit team members in your Business Unit. Passwords can't
                be changed from here.</text>
            }
        </p>
    </div>
    <div class="hero-actions">
        <a asp-controller="Users" asp-action="Create" class="btn btn-primary"
           title="Create a user directly; skips the approval queue and is sign-in-ready.">
            + New user
        </a>
    </div>
</section>

@if (Model.Pending.Count > 0)
{
    <section class="card card-warn" id="pending-approvals">
        <div class="card-header">
            <h2>
                Pending approvals
                <span class="badge badge-warn">@Model.Pending.Count</span>
            </h2>
            <small class="muted">
                New registrations waiting for your review. Approving lets the user sign in;
                rejecting deletes the registration.
            </small>
        </div>
        <div class="table-wrap users-table-wrap">
            <table class="data-table sortable users-table-compact">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Business Unit</th>
                        <th>Registered</th>
                        <th style="width:420px;" data-no-sort></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Pending)
                    {
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(u.EmployeeId))
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    @u.EmployeeId
                                }
                            </td>
                            <td><strong>@u.FullName</strong></td>
                            <td>@u.Username</td>
                            <td>@u.Email</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(u.BusinessUnit))
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    @u.BusinessUnit
                                }
                            </td>
                            <td>
                                <small class="muted">@UserClock.Format(viewer, u.CreatedAt, "yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td>
                                <button type="button" class="btn btn-success btn-sm js-approve-trigger"
                                        data-user-id="@u.Id"
                                        data-full-name="@u.FullName"
                                        data-role="@u.Role"
                                        data-business-unit="@u.BusinessUnit">
                                    Approve…
                                </button>
                                <form method="post" asp-controller="Users" asp-action="Delete"
                                      asp-route-id="@u.Id" class="inline"
                                      onsubmit="return confirm('Reject and permanently delete this registration?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="card">
    <div class="card-header">
        <h2>All accounts</h2>
        <small class="muted">@Model.Users.Count total</small>
    </div>
    <div class="table-wrap users-table-wrap">
        <table class="data-table sortable users-table-compact">
            <thead>
                <tr>
                    <th>Employee ID</th>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Business Unit</th>
                    <th>Assigned to</th>
                    <th>Status</th>
                    <th style="width:150px; white-space:nowrap;" data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="8" class="muted">No users yet.</td></tr>
                }
                else
                {
                    foreach (var u in Model.Users)
                    {
                        var isSelf = meId != null && meId == u.Id.ToString();
                        <tr @(u.IsActive ? "" : "style=\"opacity: 0.6;\"")>
                            <td>
                                @if (string.IsNullOrWhiteSpace(u.EmployeeId))
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    @u.EmployeeId
                                }
                            </td>
                            <td><strong>@u.FullName</strong></td>
                            <td>@u.Username</td>
                            <td>@u.Email</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(u.BusinessUnit))
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    @u.BusinessUnit
                                }
                            </td>
                            <td>
                                @{ var mgr = u.ManagerId.HasValue ? Model.Users.FirstOrDefault(m => m.Id == u.ManagerId.Value) : null; }
                                @if (mgr is null)
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    @mgr.FullName
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-warn">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="icon-actions">
                                    <a asp-controller="Users" asp-action="Edit"
                                       asp-route-id="@u.Id"
                                       class="icon-btn icon-btn-edit"
                                       title="Edit user" aria-label="Edit @u.FullName">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
                                        </svg>
                                    </a>
                                    <form method="post" asp-controller="Users" asp-action="ResetPassword"
                                          asp-route-id="@u.Id" class="inline"
                                          onsubmit="return confirm('Generate a new temporary password for @u.FullName? Their current password will stop working.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn icon-btn-key"
                                                title="Reset password" aria-label="Reset password for @u.FullName">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <circle cx="7.5" cy="15.5" r="3.5" />
                                                <path d="M10 13l10-10" />
                                                <path d="M16 7l3 3" />
                                                <path d="M14 9l3 3" />
                                            </svg>
                                        </button>
                                    </form>
                                    @if (u.IsActive)
                                    {
                                        @if (!isSelf)
                                        {
                                            <form method="post" asp-controller="Users" asp-action="Deactivate"
                                                  asp-route-id="@u.Id" class="inline"
                                                  onsubmit="return confirm('Deactivate @u.FullName? Their historical records will be preserved, but they won\'t be able to sign in.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="icon-btn icon-btn-warn"
                                                        title="Deactivate user" aria-label="Deactivate @u.FullName">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                         aria-hidden="true">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                                                    </svg>
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form method="post" asp-controller="Users" asp-action="Reactivate"
                                              asp-route-id="@u.Id" class="inline"
                                              onsubmit="return confirm('Reactivate @u.FullName? They\'ll be able to sign in again.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="icon-btn icon-btn-success"
                                                    title="Reactivate user" aria-label="Reactivate @u.FullName">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     aria-hidden="true">
                                                    <polyline points="20 6 9 17 4 12" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    @if (!isSelf)
                                    {
                                        <form method="post" asp-controller="Users" asp-action="Delete"
                                              asp-route-id="@u.Id" class="inline"
                                              onsubmit="return confirm('Delete @u.FullName? This removes their attendance history too.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="icon-btn icon-btn-danger"
                                                    title="Delete user" aria-label="Delete @u.FullName">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                     aria-hidden="true">
                                                    <path d="M3 6h18" />
                                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                    <path d="M10 11v6" />
                                                    <path d="M14 11v6" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@*
    Approve modal — opens when admin clicks "Approve…" on a pending
    registration. Lets them pick the target role and (depending on role)
    an Assigned-to manager or the BU list for a Program Manager.
*@
<div class="modal-backdrop" id="approve-modal" hidden aria-hidden="true">
    <div class="modal" role="dialog" aria-labelledby="approve-modal-title" aria-modal="true" style="width:min(560px, 100%);">
        <header class="modal-header">
            <div>
                <h3 id="approve-modal-title">Approve user</h3>
                <small class="muted" id="approve-modal-subtitle">Pick a role and assignment, then approve.</small>
            </div>
            <button type="button" class="modal-close" data-approve-cancel aria-label="Close">&times;</button>
        </header>
        <form id="approve-form" method="post" asp-controller="Users" asp-action="Approve">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="approve-user-id" />
            <div class="modal-body">
                @{
                    // Same filtering as the Edit / Create forms: non-pure
                    // admins can't grant the admin or program-manager tier.
                    var approveRoleChoices = Model.RoleLabelChoices
                        .Where(d => isPureAdmin
                            || (d.BaseRole != AttendanceMonitoring.Models.Roles.Admin
                             && d.BaseRole != AttendanceMonitoring.Models.Roles.ProgramManager))
                        .ToList();
                }
                <label class="field-block">
                    <span class="field-label">Role <span class="req">*</span></span>
                    <select name="roleLabelId" id="approve-role-select" required>
                        @foreach (var def in approveRoleChoices)
                        {
                            var label = def.IsBuiltIn
                                ? def.Name
                                : $"{def.Name} \u00B7 {AttendanceMonitoring.Models.Roles.DisplayName(def.BaseRole)} tier";
                            <option value="@def.Id" data-base-role="@def.BaseRole">@label</option>
                        }
                    </select>
                    @* Hidden canonical role mirrors the selected option's
                       data-base-role attribute so the existing Approve
                       handler (which reads `role`) keeps working. The
                       controller also re-derives this from roleLabelId
                       defensively on POST. *@
                    <input type="hidden" name="role" id="approve-role-hidden" value="employee" />
                </label>

                @* Employee → pick a Project Manager *@
                <div class="field-block" data-approve-show="employee" hidden>
                    <label>
                        <span class="field-label">Assigned to (Project Manager) <small class="muted">(optional)</small></span>
                        <select name="managerId" data-approve-mgr="employee">
                            <option value="">— No PM —</option>
                            @foreach (var pm in Model.ProjectManagerChoices)
                            {
                                <option value="@pm.Id">
                                    @pm.FullName (@(AttendanceMonitoring.Models.Roles.DisplayName(pm.Role)))@(string.IsNullOrEmpty(pm.BusinessUnit) ? "" : $" · {pm.BusinessUnit}")
                                </option>
                            }
                        </select>
                    </label>
                </div>

                @* Project Manager → pick a Program Manager *@
                <div class="field-block" data-approve-show="pm" hidden>
                    <label>
                        <span class="field-label">Assigned to (Program Manager) <small class="muted">(optional)</small></span>
                        <select name="managerId" data-approve-mgr="pm" disabled>
                            <option value="">— No Program Manager —</option>
                            @foreach (var pgm in Model.ProgramManagerChoices)
                            {
                                <option value="@pgm.Id">
                                    @pgm.FullName (@(AttendanceMonitoring.Models.Roles.DisplayName(pgm.Role)))
                                </option>
                            }
                        </select>
                    </label>
                </div>

                @* Business Unit applies to both Employee and Project Manager
                   tiers. Kept in its own block so PM approvals can also set
                   it; Program Managers use the multi-BU checkboxes below
                   instead. The companion JS reads space/comma separated
                   tokens from data-approve-show so this block lights up
                   for either tier. *@
                <div class="field-block" data-approve-show="employee pm" hidden>
                    <label>
                        <span class="field-label">Business Unit <small class="muted">(optional)</small></span>
                        <select name="businessUnit" data-approve-bu>
                            <option value="">— Keep current —</option>
                            @foreach (var bu in Model.BusinessUnitChoices)
                            {
                                <option value="@bu">@bu</option>
                            }
                        </select>
                    </label>
                </div>

                @* Program Manager → multi-BU checkboxes *@
                <div class="field-block" data-approve-show="program_manager" hidden>
                    <span class="field-label">Business Units <span class="req">*</span></span>
                    <div class="bu-multi">
                        @foreach (var bu in Model.BusinessUnitChoices)
                        {
                            <label class="checkbox-row">
                                <input type="checkbox" class="approve-bu-multi" value="@bu" />
                                <span>@bu</span>
                            </label>
                        }
                    </div>
                    <input type="hidden" name="businessUnits" id="approve-bu-multi-hidden" />
                    <small class="muted">Program Managers see every user whose BU is in this list (e.g. BU2 (PH) + BU2 (IN)).</small>
                </div>
            </div>
            <footer class="modal-footer selfie-actions" style="padding:14px 22px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" data-approve-cancel>Cancel</button>
                <button type="submit" class="btn btn-success">Approve</button>
            </footer>
        </form>
    </div>
</div>

<script>
    (function () {
        // Lightweight approve-modal controller. Plain JS, no deps; reuses
        // the .modal-backdrop / .modal CSS already in style.css. Mirrors
        // the wiring in _SelfieModal.cshtml so behavior is consistent.
        // The Role <select> now posts the RoleDefinition Id (roleLabelId);
        // we read the selected option's data-base-role attribute to drive
        // the rest of the form (canonical permission tier).
        var backdrop = document.getElementById('approve-modal');
        if (!backdrop) return;
        var form = document.getElementById('approve-form');
        var idInput = document.getElementById('approve-user-id');
        var subtitle = document.getElementById('approve-modal-subtitle');
        var roleSelect = document.getElementById('approve-role-select');
        var roleHidden = document.getElementById('approve-role-hidden');
        var buHidden = document.getElementById('approve-bu-multi-hidden');
        var sections = backdrop.querySelectorAll('[data-approve-show]');

        function currentBaseRole() {
            var opt = roleSelect.options[roleSelect.selectedIndex];
            return (opt && opt.getAttribute('data-base-role')) || 'employee';
        }

        function syncRoleHidden() {
            if (roleHidden) roleHidden.value = currentBaseRole();
        }

        function syncSections() {
            var role = currentBaseRole();
            sections.forEach(function (sec) {
                // data-approve-show accepts one or more tokens separated by
                // whitespace or commas (e.g. "employee pm") so a single
                // block can apply to multiple approval tiers (Business Unit
                // applies to both Employee and PM, for example).
                var allowed = (sec.getAttribute('data-approve-show') || '')
                    .split(/[\s,]+/)
                    .filter(Boolean);
                var show = allowed.indexOf(role) !== -1;
                sec.hidden = !show;
                // Disable inputs in hidden sections so they don't post.
                sec.querySelectorAll('input, select').forEach(function (el) {
                    el.disabled = !show;
                });
            });
        }

        function open(trigger) {
            idInput.value = trigger.getAttribute('data-user-id') || '';
            subtitle.textContent = 'Approving ' + (trigger.getAttribute('data-full-name') || 'user') + '.';
            // Pre-select the role definition whose BaseRole matches the
            // role the user registered with (typically "employee"). The
            // dropdown is now keyed by RoleDefinition.Id, so we have to
            // hunt for a matching option instead of setting value directly.
            var initialRole = (trigger.getAttribute('data-role') || 'employee').toLowerCase();
            var matched = false;
            for (var i = 0; i < roleSelect.options.length; i++) {
                var opt = roleSelect.options[i];
                if ((opt.getAttribute('data-base-role') || '') === initialRole) {
                    roleSelect.selectedIndex = i;
                    matched = true;
                    break;
                }
            }
            if (!matched && roleSelect.options.length > 0) {
                roleSelect.selectedIndex = 0;
            }
            syncRoleHidden();
            // Pre-fill single-BU dropdown with the user's existing BU
            // when present so the admin doesn't lose context on approve.
            var existingBu = trigger.getAttribute('data-business-unit') || '';
            var buSelect = backdrop.querySelector('[data-approve-bu]');
            if (buSelect) {
                buSelect.value = existingBu;
            }
            // Reset multi-BU checkboxes.
            backdrop.querySelectorAll('.approve-bu-multi').forEach(function (c) { c.checked = false; });
            buHidden.value = '';
            syncSections();
            backdrop.hidden = false;
            backdrop.setAttribute('aria-hidden', 'false');
            document.body.classList.add('modal-open');
        }

        function close() {
            backdrop.hidden = true;
            backdrop.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('modal-open');
        }

        document.querySelectorAll('.js-approve-trigger').forEach(function (btn) {
            btn.addEventListener('click', function () { open(btn); });
        });
        backdrop.querySelectorAll('[data-approve-cancel]').forEach(function (el) {
            el.addEventListener('click', close);
        });
        backdrop.addEventListener('click', function (e) {
            if (e.target === backdrop) close();
        });
        roleSelect.addEventListener('change', function () {
            syncRoleHidden();
            syncSections();
        });

        form.addEventListener('submit', function (e) {
            // Roll the checked BU boxes up into a semicolon list before
            // posting, since checkboxes don't natively post a CSV.
            if (currentBaseRole() === 'program_manager') {
                var picked = [];
                backdrop.querySelectorAll('.approve-bu-multi:checked').forEach(function (c) {
                    picked.push(c.value);
                });
                if (picked.length === 0) {
                    e.preventDefault();
                    alert('Please pick at least one Business Unit for the Program Manager.');
                    return;
                }
                buHidden.value = picked.join(';');
                buHidden.disabled = false;
            }
        });
    })();
</script>
