@model List<AttendanceMonitoring.Models.RoleDefinition>
@{
    ViewData["Title"] = "Configuration";
    var usage = ViewBag.UsageCounts as Dictionary<int, int>
                 ?? new Dictionary<int, int>();
    var viewer = ViewData["ViewerUser"] as User;
}

<section class="hero">
    <div>
        <h1>Configuration</h1>
        <p class="muted">
            Manage the <strong>Role</strong> dropdown that appears on the
            Users &rarr; Create / Edit / Approve screens. Each entry maps
            to one of four base permission tiers
            (<em>Administrator</em>, <em>Program Manager</em>,
            <em>Project Manager</em>, <em>Employee</em>) which is what
            actually drives access throughout the app.
        </p>
        <p class="muted">
            The four built-in rows are seeded automatically and can't be
            deleted. Add your own entries (e.g. <em>Senior Engineer</em>,
            <em>QA Lead</em>) when you want a more specific label &mdash; pick
            the tier whose access level matches.
        </p>
    </div>
</section>

<section class="card">
    <div class="card-header">
        <h2>Add a role</h2>
        <small class="muted">e.g. Senior Engineer (Employee tier), QA Lead (Project Manager tier)</small>
    </div>
    <form method="post" asp-action="Create" class="form form-inline">
        @Html.AntiForgeryToken()
        <label class="grow">
            <span class="field-label">Role name <span class="req">*</span></span>
            <input type="text" name="name" maxlength="80" required
                   placeholder="e.g. Senior Engineer" />
        </label>
        <label>
            <span class="field-label">Base permission tier <span class="req">*</span></span>
            <select name="baseRole" required>
                <option value="" disabled selected>&mdash; Pick a tier &mdash;</option>
                <option value="@AttendanceMonitoring.Models.Roles.Employee">Employee</option>
                <option value="@AttendanceMonitoring.Models.Roles.Operations">Operations</option>
                <option value="@AttendanceMonitoring.Models.Roles.Pm">Project Manager</option>
                <option value="@AttendanceMonitoring.Models.Roles.ProgramManager">Program Manager</option>
                <option value="@AttendanceMonitoring.Models.Roles.Admin">Administrator</option>
            </select>
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">+ Add role</button>
        </div>
    </form>
</section>

<section class="card">
    <div class="card-header">
        <h2>Existing roles</h2>
        <small class="muted">@Model.Count total</small>
    </div>
    <div class="table-wrap">
        <table class="data-table sortable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Permission tier</th>
                    <th>Source</th>
                    <th>Created</th>
                    <th>Assigned to</th>
                    <th style="width:120px;" data-no-sort></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="muted">No roles yet. Add one above to get started.</td></tr>
                }
                else
                {
                    foreach (var r in Model)
                    {
                        var count = usage.TryGetValue(r.Id, out var c) ? c : 0;
                        var tierClass = r.BaseRole switch
                        {
                            AttendanceMonitoring.Models.Roles.Admin          => "badge badge-danger",
                            AttendanceMonitoring.Models.Roles.ProgramManager => "badge badge-warn",
                            AttendanceMonitoring.Models.Roles.Pm             => "badge badge-active",
                            AttendanceMonitoring.Models.Roles.Operations     => "badge badge-active",
                            _                                                => "badge badge-done",
                        };
                        <tr>
                            <td><strong>@r.Name</strong></td>
                            <td>
                                <span class="@tierClass">@AttendanceMonitoring.Models.Roles.DisplayName(r.BaseRole)</span>
                            </td>
                            <td>
                                @if (r.IsBuiltIn)
                                {
                                    <span class="badge">Built-in</span>
                                }
                                else
                                {
                                    <span class="muted">Custom</span>
                                }
                            </td>
                            <td>
                                <small class="muted">
                                    @AttendanceMonitoring.Services.UserClock.Format(viewer, r.CreatedAt, "yyyy-MM-dd HH:mm")
                                </small>
                            </td>
                            <td>
                                @if (count == 0)
                                {
                                    <span class="muted">&mdash;</span>
                                }
                                else
                                {
                                    <span>@count user@(count == 1 ? "" : "s")</span>
                                }
                            </td>
                            <td>
                                @if (r.IsBuiltIn)
                                {
                                    <span class="muted" title="Built-in roles can't be deleted.">&mdash;</span>
                                }
                                else
                                {
                                    <form method="post" asp-action="Delete"
                                          asp-route-id="@r.Id" class="inline"
                                          onsubmit="return confirm('Delete role &quot;@r.Name&quot;? @(count > 0 ? $"This will clear the label from {count} user(s)." : "")');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="icon-btn icon-btn-danger"
                                                title="Delete role" aria-label="Delete @r.Name">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <path d="M3 6h18" />
                                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                                <path d="M10 11v6" />
                                                <path d="M14 11v6" />
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
