@model AttendanceMonitoring.Models.Site
@{
    ViewData["Title"] = "Edit site";
}

<section class="hero">
    <div>
        <h1>Edit site</h1>
    </div>
    <div>
        <a asp-action="Index" class="btn">&larr; Back</a>
    </div>
</section>

<section class="card">
    <form method="post" asp-action="EditPost" asp-route-id="@Model.Id" class="form">
        @Html.AntiForgeryToken()
        <label>
            <span class="field-label">Name <span class="req">*</span></span>
            <input type="text" asp-for="Name" maxlength="120" required />
        </label>
        <div class="form-row">
            <label>
                <span class="field-label">Latitude <span class="req">*</span></span>
                <input type="number" step="any" asp-for="Latitude" required />
            </label>
            <label>
                <span class="field-label">Longitude <span class="req">*</span></span>
                <input type="number" step="any" asp-for="Longitude" required />
            </label>
            <label>
                <span class="field-label">Radius (m)</span>
                <input type="number" min="10" max="5000" asp-for="RadiusMeters" />
            </label>
        </div>
        <label>
            <span class="field-label">Business Unit</span>
            <input type="text" asp-for="BusinessUnit" maxlength="120" placeholder="Leave blank for all BUs" />
        </label>
        <label>
            <span class="field-label">Notes</span>
            <textarea asp-for="Notes" maxlength="500" rows="3"></textarea>
        </label>
        <label class="checkbox-row">
            <input type="checkbox" asp-for="IsActive" />
            <span>Active</span>
        </label>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Index" class="btn">Cancel</a>
        </div>
    </form>
</section>
