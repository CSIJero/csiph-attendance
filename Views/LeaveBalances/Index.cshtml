@model List<AttendanceMonitoring.Models.LeaveBalance>
@{
    ViewData["Title"] = "Leave balances";
    var userFilter = ViewBag.UserFilter as int?;
    var buFilter = ViewBag.BuFilter as string;
}

<section class="hero">
    <div>
        <h1>Leave balances</h1>
        <p class="muted">
            Automatically accrued on the 1st of each calendar month:
            Vacation 6.67h / Sick 5.33h / Personal 2.67h, capped at
            80h / 64h / 32h respectively (10 / 8 / 4 days at 8h).
            YTD totals reset every January.
        </p>
    </div>
</section>

<section class="card">
    <div class="card-header">
        <h2>Balances</h2>
        <form method="get" class="form form-inline">
            <label>
                <span class="field-label">Business Unit</span>
                <input type="text" name="bu" value="@buFilter" placeholder="any" />
            </label>
            <button type="submit" class="btn">Filter</button>
        </form>
    </div>
    <div class="table-wrap">
        <table class="data-table sortable">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>BU</th>
                    <th>Type</th>
                    <th class="text-right">Remaining (h)</th>
                    <th class="text-right">YTD accrued</th>
                    <th class="text-right">YTD used</th>
                    <th>Last accrual</th>
                    <th style="width:280px;" data-no-sort>Adjust</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="muted text-center">No leave balances yet — the accrual job runs every 6h and on app start.</td></tr>
                }
                else
                {
                    foreach (var b in Model)
                    {
                        <tr>
                            <td><strong>@b.User?.FullName</strong> <small class="muted">@b.User?.Username</small></td>
                            <td>@b.User?.BusinessUnit</td>
                            <td>@b.LeaveType</td>
                            <td class="text-right">@b.HoursRemaining.ToString("F2")</td>
                            <td class="text-right">@b.HoursAccruedYtd.ToString("F2")</td>
                            <td class="text-right">@b.HoursUsedYtd.ToString("F2")</td>
                            <td>@(b.LastAccrualMonth?.ToString("yyyy-MM") ?? "—")</td>
                            <td>
                                <form method="post" asp-action="Adjust" asp-route-id="@b.Id" class="form-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="number" step="0.25" name="delta" required style="width:90px;" placeholder="±h" />
                                    <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
